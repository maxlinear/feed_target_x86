/*
 * The image source file creates FIT image with MXL URX Linux kernel Device Tree FIT and rootfs FIT
 */

/dts-v1/;

/ {
	description = "FIT image with MXL URX Linux kernel-DTB FIT and rootfs FIT image";

	images {
		kernel-dtb {
			description = "MXL URX Linux kernel and DTB FIT Image";
			data = /incbin/("KERNEL-DTB");
			type = "firmware";
			arch = "x86_64";
			os = "linux";
			compression = "none";
		};
		filesystem {
			description = "MXL URX Rootfs FIT image";
			data = /incbin/("ROOTFS");
			type = "firmware";
			arch = "x86_64";
			compression = "none";
		};
	};

	configurations {
		default = "kernel-dtb-rootfs-conf";
		kernel-dtb-rootfs-conf {
			description = "MXL URX Linux kernel + DBT + rootfs";
			kernel = "kernel-dtb";
			filesystem = "filesystem";
		};
	};
};

