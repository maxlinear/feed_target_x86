software =
{
	description = "Firmware update for Prpl opensource Project";
	version = PRPLOS_VERSION;
	hardware-compatibility:
	[
		"#RE:.*"
	];
	board_name = {
		active =
		{
			full =
			{
				images =
				(
					{
						name = "kernel-inactive";
						filename = "ext4.img";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0";
						volume = "kernel-inactive";
						noinuse = "true";
						installed-directly = false;
					},
				);
				scripts =
		(
					{
						type = "gptswap";
						device = "/dev/mmcblk0";
						properties =
						{
							swap-0 =
							[
								"kernel-active",
								"kernel-inactive"
							];
							noinuse = "true";
						};
					},
					{
						filename = "prpl-backup.lua";
						type = "lua";
					},
					{
						filename = "prpl-enable-failover.lua";
						type = "lua";
					},
				);
			};
			flash-only =
			{
				images =
				(
					{
						name = "kernel-inactive";
						filename = "ext4.img";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0";
						volume = "kernel-inactive";
						noinuse = "true";
						installed-directly = True;
					},
				);
				scripts =
				(
					{
						filename = "prpl-enable-failover.lua";
						type = "lua";
					},
				);
			};
		};
		inactive =
		{
			full =
			{
				images =
				(
					{
						name = "kernel-active";
						filename = "ext4.img";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0";
						volume = "kernel-active";
						noinuse = "true";
						installed-directly = false;
					},
				);
				scripts =
				(
					{
						filename = "prpl-backup.lua";
						type = "lua";
					},
					{
						filename = "prpl-enable-failover.lua";
						type = "lua";
					},
				);
			};
			flash-only =
			{
				images =
				(
					{
						name = "kernel-active";
						filename = "ext4.img";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0";
						volume = "kernel-active";
						noinuse = "true";
						installed-directly = True;
					},
				);
				scripts =
				(
					{
						filename = "prpl-enable-failover.lua";
						type = "lua";
					},
				);
			};
		};
	};
};
