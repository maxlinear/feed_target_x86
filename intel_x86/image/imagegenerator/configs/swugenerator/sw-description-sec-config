software =
{
	description = "Firmware update for Prpl opensource Project";
	version = "1.0.0";
	hardware-compatibility:
	[
		"#RE:.*"
	];
	board_name = {
		active =
		{
			full =
			{
				images =
				(
					{
						name = "rbe";
						filename = "u-boot-spl-emmc.bin";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0boot0";
						noinuse = "true";
						installed-directly = false;
					},
					{
						name = "u-boot-inactive";
						filename = "u-boot.itb";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0";
						volume = "u-boot-inactive";
						noinuse = "true";
						installed-directly = false;
					},
					{
						name = "tep-inactive";
						filename = "tep_fw.itb";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0";
						volume = "tep-inactive";
						noinuse = "true";
						installed-directly = false;
					},
					{
						name = "kernel-inactive";
						filename = "ext4.img";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0";
						volume = "kernel-inactive";
						noinuse = "true";
						installed-directly = false;
					},
				);
				scripts =
		(
					{
						type = "gptswap";
						device = "/dev/mmcblk0";
						properties =
						{
							swap-0 =
							[
								"u-boot-active",
								"u-boot-inactive"
							];
							swap-1 =
							[
								"tep-active",
								"tep-inactive"
							];
							swap-2 =
							[
								"kernel-active",
								"kernel-inactive"
							];
							noinuse = "true";
						};
					},
					{
						filename = "prpl-backup.lua";
						type = "lua";
					},
					{
						filename = "prpl-enable-failover.lua";
						type = "lua";
					},
				);
			};
		};
		inactive =
		{
			full =
			{
				images =
				(
					{
						name = "rbe";
						filename = "u-boot-spl-emmc.bin";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0boot0";
						noinuse = "true";
						installed-directly = false;
					},
					{
						name = "u-boot-active";
						filename = "u-boot.itb";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0";
						volume = "u-boot-active";
						noinuse = "true";
						installed-directly = false;
					},
					{
						name = "tep-active";
						filename = "tep_fw.itb";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0";
						volume = "tep-active";
						noinuse = "true";
						installed-directly = false;
					},
					{
						name = "kernel-active";
						filename = "ext4.img";
						type = "mxl_imghdlr";
						device = "/dev/mmcblk0";
						volume = "kernel-active";
						noinuse = "true";
						installed-directly = false;
					},
				);
				scripts = (
					{
						filename = "prpl-backup.lua";
						type = "lua";
					},
					{
						filename = "prpl-enable-failover.lua";
						type = "lua";
					},
				);
			};
		};
	};
};
